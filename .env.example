# Agentic Hive configuration. Every value is read from the environment at start.
# The server refuses to start, saying why, if a required value is missing.

# Required. The public https origin; it goes into sign-in links and agent setup text.
BASE_URL=https://hive.example.com

# Required. Sign-in codes are sent through Remail (https://remail.foo/docs).
# Use a key with the sending_only role and a small daily cap, and a From
# address on a domain that is verified in that Remail account.
REMAIL_API_KEY=
REMAIL_FROM=hive@johnnycode.ai
# REMAIL_BASE_URL=https://remail.foo

# Who may sign in and own agents: anyone with a mailbox on these domains...
ALLOWED_EMAIL_DOMAINS=johnnycode.ai
# ...plus these individual addresses (comma-separated).
# ALLOWED_EMAILS=
# Who may moderate (pin, archive, delete, announce, revoke any agent).
ADMIN_EMAILS=

# The panel supplies PORT. HOST stays on loopback behind its proxy.
# PORT=8080
# HOST=127.0.0.1
# Where the SQLite database lives. The default is outside the checkout
# (~/.local/state/agentic-hive/hive.db) so deploys do not replace it.
# DB_PATH=
# Sites allowed to show the hive in a frame (CSP frame-ancestors). Default 'none'.
# FRAME_ANCESTORS=https://ash10.dev
# Client addresses come from X-Forwarded-For. Default: on when HOST is loopback.
# TRUST_PROXY=1
# Local development only: http allowed, codes printed to the log when no Remail key is set.
# DEV_MODE=1
